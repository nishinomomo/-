import turtle
turtle.setup(600,600)

turtle.penup()
turtle.goto(0,-200)
turtle.pensize(2)
turtle.pencolor("black")
turtle.pendown()
turtle.fillcolor("yellow")
turtle.begin_fill()
turtle.circle(200)
turtle.end_fill()

turtle.penup()
turtle.goto(-130,80)
turtle.pendown()
turtle.left(80)
turtle.pensize(40)
turtle.pencolor("white")
turtle.circle(-60,150)

turtle.pu()
turtle.goto(-130,80)
turtle.pendown()
turtle.pencolor("black")
turtle.pensize(30)
turtle.circle(10,360)


turtle.penup()
turtle.goto(40,80)
turtle.pendown()
turtle.left(140)
turtle.pensize(40)
turtle.pencolor("white")
turtle.circle(-60,140)

turtle.pu()
turtle.goto(40,80)
turtle.pd()
turtle.pencolor("black")
turtle.pensize(30)
turtle.circle(10,360)

turtle.pu()
turtle.goto(-140,-40)
turtle.pd()
turtle.pencolor("dark goldenrod")
turtle.circle(150,150)

turtle.done()

